---
import { CLOVER, BIZ } from '../site.ts';
---

<section class="hero" id="hero">
  <!--
    Sources are attached by the inline script below, never in the markup, so that
    prefers-reduced-motion gets the poster still and nothing else, and phones are
    never handed the 1080p file. preload="none" keeps the reel off the critical path.

    No poster attribute: the poster is the section's CSS background instead, so the
    portrait and landscape stills can be picked by media query (a poster attribute
    can't be), and it still shows with JavaScript off.
  -->
  <video
    class="hero__video"
    id="heroVideo"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
  ></video>

  <div class="hero__scrim" aria-hidden="true"></div>

  <div class="hero__content shell">
    <p class="hero__kicker">{BIZ.tagline}</p>
    <h1 class="hero__line">Love&nbsp;&amp;&nbsp;Flour Bakery</h1>
    <p class="hero__sub">Pan dulce, cakes, and breakfast in a warm and welcoming atmosphere.</p>
    <div class="hero__actions">
      <a class="btn" href={CLOVER} target="_blank" rel="noopener">Order online</a>
      <a class="link-quiet" href="/order-cakes">Order a cake</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 620px;
    /* The full screen with the browser bars hidden (lvh), not the smaller
       screen with them showing (svh). On iPhone Safari the bottom toolbar
       floats over the page, so a 100svh hero stopped above it and the next
       section showed through underneath. The video now runs to the screen's
       bottom edge; .hero__content adds the difference back as padding, so the
       text and buttons stay above the toolbar. Desktop: lvh = svh, no change. */
    height: 100svh;
    height: 100lvh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    /* The poster, showing until the first frame plays (and for good under
       reduced motion). Same frame as the video's first, dimmed by the same scrim. */
    background: var(--espresso) url('/video/hero-poster.jpg') center / cover no-repeat;
  }
  /* Upright screens (phones, a tablet held upright) get the reel shot vertically.
     Keep in step with the script below and the preloads in Base.astro. */
  @media (max-aspect-ratio: 4/5) {
    .hero { background-image: url('/video/hero-portrait-poster.jpg'); }
  }

  .hero__video {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    /* Nothing is baked into the encode — the footage ships at its natural
       exposure and all the darkening happens in the scrim below, so it stays
       tweakable without re-encoding. */
  }

  /*
    Dimming is a FLAT black layer at --hero-dim, i.e. the footage sitting at
    reduced opacity over black. That's a linear multiply: it holds shadow detail
    and the relationship between tones. An earlier curves-based grade crushed the
    blacks into mud, which is exactly what this avoids.

    The two gradients on top of it are only for legibility — text at the bottom,
    nav at the top — and are kept light so they don't reintroduce the same problem.
  */
  .hero { --hero-dim: 0.45; }

  .hero__scrim {
    position: absolute; inset: 0;
    background:
      linear-gradient(to top,
        rgba(0, 0, 0, 0.34) 0%,
        rgba(0, 0, 0, 0.16) 28%,
        transparent 58%),
      linear-gradient(to bottom,
        rgba(0, 0, 0, 0.30) 0%,
        transparent 18%),
      rgba(0, 0, 0, var(--hero-dim));
  }
  /* iOS Safari paints its status bar and toolbar solid espresso over this page
     (see the tint notes in Nav.astro). Fade the footage into that colour at
     both edges so the bars melt into the video instead of ending in a line.
     The top fade starts below the status bar when the page draws under it
     (safe-area inset); the bottom one starts above the floating toolbar. */
  @supports (-webkit-touch-callout: none) {
    .hero__scrim {
      background:
        linear-gradient(to bottom,
          rgb(36 22 17) env(safe-area-inset-top, 0px),
          rgb(36 22 17 / 0) calc(env(safe-area-inset-top, 0px) + 110px)),
        linear-gradient(to top,
          rgb(36 22 17) calc(100lvh - 100svh),
          rgb(36 22 17 / 0) calc(100lvh - 100svh + 130px)),
        linear-gradient(to top,
          rgba(0, 0, 0, 0.34) 0%,
          rgba(0, 0, 0, 0.16) 28%,
          transparent 58%),
        rgba(0, 0, 0, var(--hero-dim));
    }
  }

  .hero__content {
    position: relative;
    padding-bottom: clamp(3rem, 8vh, 6.5rem);
    padding-bottom: calc(clamp(3rem, 8vh, 6.5rem) + (100lvh - 100svh));
    padding-top: 8rem;
    color: #fff;
  }

  .hero__kicker {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--blush);
    margin: 0 0 1.1rem;
  }

  .hero__line {
    /* The name is the headline. The 12.7vw cap keeps "Love & Flour" on one
       line on the narrowest phones. */
    font-size: min(12.7vw, clamp(2.85rem, 2rem + 3.4vw, 5.25rem));
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.028em;
    max-width: 19ch;
    margin: 0;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
  }

  .hero__sub {
    font-size: var(--step-1);
    line-height: 1.35;
    max-width: 34ch;
    margin: clamp(0.8rem, 2vh, 1.15rem) 0 0;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.4);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.25rem);
    flex-wrap: wrap;
    margin-top: clamp(1.8rem, 4vh, 2.75rem);
  }
  .hero__actions .link-quiet { color: #fff; }
</style>

<script is:inline>
  (function () {
    var v = document.getElementById('heroVideo');
    if (!v) return;

    // Reduced motion: keep the poster still, attach nothing, download nothing.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Upright screens get the vertical reel: the landscape one cropped to a
    // phone keeps only a thin strip from the middle of the frame.
    var portrait = window.matchMedia('(max-aspect-ratio: 4/5)').matches;
    var small = window.matchMedia('(max-width: 860px)').matches;
    var base = portrait ? '/video/hero-portrait-720'
             : small ? '/video/hero-720'
             : '/video/hero-1080';

    // Apple devices get the H.264 mp4 first: Safari decodes it in hardware, and
    // its VP9 webm playback is what smeared when coming back from the background.
    var apple = /iP(hone|ad|od)/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1) ||
      (/Safari\//.test(navigator.userAgent) && !/Chrome|Chromium|Edg|Firefox/.test(navigator.userAgent));
    var formats = [['webm', 'video/webm'], ['mp4', 'video/mp4']];
    if (apple) formats.reverse();
    formats.forEach(function (f) {
      var s = document.createElement('source');
      s.src = base + '.' + f[0];
      s.type = f[1];
      v.appendChild(s);
    });

    v.load();
    var p = v.play();
    if (p && p.catch) p.catch(function () { /* autoplay refused — poster stands */ });

    // iOS suspends the video when Safari goes to the background and can hand it
    // back frozen on a smeared, half-decoded frame, sometimes while still
    // reporting itself as playing. So after any trip to the background, reload
    // the clip and carry on from where it was rather than trusting its state.
    var away = false, at = 0;
    function leave() { away = true; at = v.currentTime || 0; }
    function back() {
      if (!away || document.visibilityState !== 'visible') return;
      away = false;
      v.addEventListener('loadedmetadata', function seek() {
        v.removeEventListener('loadedmetadata', seek);
        try { if (at && v.duration) v.currentTime = at % v.duration; } catch (e) {}
      });
      v.load();
      var r = v.play();
      if (r && r.catch) r.catch(function () {});
    }
    document.addEventListener('visibilitychange', function () {
      if (document.visibilityState === 'hidden') leave(); else back();
    });
    window.addEventListener('pagehide', leave);
    window.addEventListener('pageshow', function (e) { if (e.persisted) { away = true; back(); } });
  })();
</script>
