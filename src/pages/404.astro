---
/*
 * Not found. Astro builds this to /404.html, which Netlify serves for any path
 * that doesn't exist. That includes old Wix links still out in the world.
 * noindex: it's a dead end for search results.
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { flavorById } from '../data/cakes.ts';

const cake = flavorById('strawberry')!;
---

<Base
  title="Page not found — Love & Flour Bakery"
  description="That page couldn't be found. Head back to the Love & Flour menu, cake orders or contact page."
  noindex
>
  <section class="section lost">
    <div class="shell lost__inner">
      <div class="lost__plate">
        <Image src={cake.img!} alt="" widths={[260, 420]} sizes="210px" loading="eager" />
      </div>

      <p class="eyebrow">Page not found</p>
      <h1 class="lost__h">This page isn't on the menu.</h1>
      <p class="lede">
        The link may be old, or the page moved when we rebuilt the site.
        Here's where most people are headed:
      </p>

      <ul class="lost__links">
        <li><a class="link-quiet" href="/menu">Menu</a></li>
        <li><a class="link-quiet" href="/order-cakes">Order a cake</a></li>
        <li><a class="link-quiet" href="/about">Our story</a></li>
        <li><a class="link-quiet" href="/contact">Contact</a></li>
      </ul>

      <a class="btn" href="/">Back to the bakery</a>
    </div>
  </section>
</Base>

<style>
  .lost { text-align: center; padding-block: clamp(3rem, 8vw, 5.5rem); }
  .lost__inner { max-width: 56ch; margin-inline: auto; }

  .lost__plate { width: min(210px, 55vw); margin: 0 auto clamp(1.5rem, 4vw, 2.25rem); }
  .lost__plate :global(img) {
    width: 100%; height: auto;
    /* Same alpha drop-shadow as the cakes everywhere else. */
    filter: drop-shadow(0 12px 12px rgba(59, 36, 27, 0.22));
  }

  .lost .eyebrow { color: var(--ink-faint); margin-bottom: 0.5rem; }
  .lost__h { font-size: var(--step-3); letter-spacing: -0.025em; margin-bottom: 1rem; }
  .lost .lede { margin-inline: auto; }

  .lost__links {
    list-style: none; margin: clamp(1.75rem, 4vw, 2.25rem) 0 0; padding: 0;
    display: flex; flex-wrap: wrap; justify-content: center;
    gap: 0.9rem clamp(1.25rem, 3vw, 2rem);
  }
  .lost__links a { color: var(--ink); }

  .lost .btn { margin-top: clamp(2rem, 5vw, 2.75rem); }
</style>
